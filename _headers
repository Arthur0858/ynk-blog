/downloads/*
  Cache-Control: public, max-age=604800

/guides/*
  Cache-Control: public, max-age=300

/status/*
  Cache-Control: public, max-age=60

/*.html
  Cache-Control: public, max-age=300

/contact
  Cache-Control: public, max-age=300

/privacy
  Cache-Control: public, max-age=300

/disclosure
  Cache-Control: public, max-age=300

/styles.css
  Cache-Control: public, max-age=300

/sitemap.xml
  Cache-Control: public, max-age=300

/robots.txt
  Cache-Control: public, max-age=300
